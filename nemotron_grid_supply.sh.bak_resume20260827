#!/bin/bash
# nemotron_grid_supply.sh -- persistent daemon supplying the NEMOTRON baseline
# grid (8 methods x 6 datasets: cad dola vcd avcd opera tot gd pd).
# Structure copied from run_grid_supply.sh (90s poll / atomic claim / crash-safe
# disk-recomputed queue / cards 0-3 ONLY / MEM_FREE_MIB=2000) with:
#   (a) queue = ${ds}_nemotron_${m} cells, runner run_nemotron_grid_cell.sh;
#   (b) DUAL POOLS (user authorisation 2026-08-24 ~15:45, ~7h window):
#       POOL A = cards 4/5 ONLY, SHORT cells only (cad/dola x {haloquest,
#       avhbench}, vcd x {pubmedqa,ragtruth,haloquest,avhbench}), runs
#       IMMEDIATELY. Cards 6/7 stay EMPTY. WINDOW GUARD: no new pool-A launch
#       after NEMO_BORROW_WINDOW_SEC (default 6.5h = 23400s) from daemon start;
#       running cells finish naturally. Yield: a card with a FOREIGN compute
#       process (cmdline not ours) gets no new cells.
#       POOL B = cards 0-3, gated on the Qwen3 queue being EMPTY (all 9 methods
#       x 6 ds scored complete, same sampling rules), then serves ALL remaining
#       cells (long ones: tot/gd/pd/avcd/opera stay pool-B only).
#   (c) per-cell failure counter: a cell that ends rc!=0 with ZERO raw rows
#       three times is marked .skip (structural gap / broken runner) so a
#       crashing runner cannot spin a card forever.
# Sampling rules (user decision 2026-08-24): tot/gd/pd = 1/9 on ALL six datasets
# (deterministic stratified {ds}_1of9.json via make_1of9.py, seed 20260824);
# opera = FULL on judgement family (pubmedqa/cmm/phd), 1/3 on description
# family (same as the Qwen3 grid); cad/dola/vcd/avcd = 1/3 on ALL six datasets
# (cells already completed at FULL stay complete -- the gate is rows >= exp).
# The Qwen3-completion START GATE keeps the Qwen3 grid's own sampling rules.
set -u
cd /home/tsq/rhq/omniconfess/OmniConfess
CLAIMDIR=/tmp/nemotron_grid_claims
FAILDIR=/tmp/nemotron_grid_fails
mkdir -p "$CLAIMDIR" "$FAILDIR"
LOG_PREFIX="[nemo-supply]"
POLL=90
MEM_FREE_MIB=2000

declare -A EXP_FULL=( [pubmedqa]=468 [cmm]=721 [phd]=906 [ragtruth]=435 [haloquest]=365 [avhbench]=645 )
declare -A EXP_13=(   [pubmedqa]=156 [cmm]=240 [phd]=302 [ragtruth]=145 [haloquest]=122 [avhbench]=215 )
# 1/9 of FULL for the degenerate family (tot/gd/pd), user decision 2026-08-24;
# files generated by make_1of9.py (deterministic stratified subset of _1of3.json,
# seed 20260824), expected rows: pubmedqa 52/cmm 80/phd 101/ragtruth 48/haloquest 41/avhbench 72
declare -A EXP_19=(   [pubmedqa]=52 [cmm]=80 [phd]=101 [ragtruth]=48 [haloquest]=41 [avhbench]=72 )

JUDGE="pubmedqa cmm phd"
DESC="ragtruth haloquest avhbench"
NEMO_METHODS="cad dola vcd avcd opera tot gd pd"
QWEN3_METHODS="cad dola gd pd sc tot vcd avcd opera"

# pool-A short cells (user list 2026-08-24, estimated <1.5h each)
SHORT_CELLS="haloquest_nemotron_cad avhbench_nemotron_cad haloquest_nemotron_dola avhbench_nemotron_dola pubmedqa_nemotron_vcd ragtruth_nemotron_vcd haloquest_nemotron_vcd avhbench_nemotron_vcd"
WINDOW_START=$(date +%s)
WINDOW_SEC=${NEMO_BORROW_WINDOW_SEC:-23400}   # 6.5h of the ~7h authorisation

# cell_spec <ds> <m> -> echo "<backbone> <ds> <m> <data> <exp>" (backbone qwen3|nemotron)
cell_spec() {
  local bb=$1 ds=$2 m=$3 exp data
  if echo "tot gd pd" | grep -qw "$m"; then
    data="OmniHalluBench/${ds}/${ds}_1of3.json"; exp=${EXP_13[$ds]}
  elif [ "$m" = "opera" ] && echo " $DESC " | grep -q " $ds "; then
    data="OmniHalluBench/${ds}/${ds}_1of3.json"; exp=${EXP_13[$ds]}
  else
    data="OmniHalluBench/${ds}/${ds}.json"; exp=${EXP_FULL[$ds]}
  fi
  [ -f "$data" ] || return 1
  echo "$bb $ds $m $data $exp"
}

# gate: Qwen3 queue empty (all cells scored complete)
qwen3_done() {
  local ds m spec cell scored sn
  for ds in $JUDGE $DESC; do
    for m in $QWEN3_METHODS; do
      spec=$(cell_spec qwen3 "$ds" "$m") || continue
      cell="${ds}_qwen3_${m}"
      scored="outputs/${cell}/${cell}_full_single_scored.jsonl"
      if [ ! -f "$scored" ]; then return 1; fi
      sn=$(wc -l < "$scored" 2>/dev/null || echo 0)
      [ "$sn" -ge "$(echo "$spec" | awk '{print $5}')" ] || return 1
    done
  done
  return 0
}

compute_queue() {  # echoes "ds m data exp" per INCOMPLETE launchable cell
  local ds m data exp cell out scored sn
  for ds in $JUDGE $DESC; do
    for m in $NEMO_METHODS; do
      if echo "tot gd pd" | grep -qw "$m"; then
        data="OmniHalluBench/${ds}/${ds}_1of9.json"; exp=${EXP_19[$ds]}
      elif [ "$m" = "opera" ]; then
        if echo " $DESC " | grep -q " $ds "; then
          data="OmniHalluBench/${ds}/${ds}_1of3.json"; exp=${EXP_13[$ds]}
        else
          data="OmniHalluBench/${ds}/${ds}.json"; exp=${EXP_FULL[$ds]}
        fi
      elif echo "cad dola vcd avcd" | grep -qw "$m"; then
        # contrastive family 1/3 on ALL six (user decision 2026-08-24); cells
        # already completed at FULL remain complete (gate is rows >= exp).
        data="OmniHalluBench/${ds}/${ds}_1of3.json"; exp=${EXP_13[$ds]}
      else
        data="OmniHalluBench/${ds}/${ds}.json"; exp=${EXP_FULL[$ds]}
      fi
      [ -f "$data" ] || continue
      cell="${ds}_nemotron_${m}"
      [ -f "$FAILDIR/${cell}.skip" ] && continue
      out="outputs/${cell}"
      scored="$out/${cell}_full_single_scored.jsonl"
      if [ -f "$scored" ]; then
        sn=$(wc -l < "$scored" 2>/dev/null || echo 0)
        [ "$sn" -ge "$exp" ] && continue
      fi
      [ -d "$CLAIMDIR/${cell}.run" ] && continue
      echo "$ds $m $data $exp"
    done
  done
}

# a card is OURS if it has no compute apps, or every compute-app pid's cmdline
# belongs to one of our nemotron cell processes.
card_ours() {
  local g=$1 pid cmd
  for pid in $(nvidia-smi -i "$g" --query-compute-apps=pid --format=csv,noheader 2>/dev/null); do
    cmd=$(tr '\0' ' ' < /proc/$pid/cmdline 2>/dev/null)
    case "$cmd" in
      *run_nemotron_grid_cell*|*_nemotron_hf.py*) ;;
      *) return 1 ;;
    esac
  done
  return 0
}

card_free() {
  local g=$1 used
  used=$(nvidia-smi -i "$g" --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null)
  [ -n "$used" ] && [ "$used" -lt "$MEM_FREE_MIB" ]
}

available_cards() {  # cards 0-3 ONLY (4-7 off-limits; reserve file respected)
  local c cards=""
  for c in 0 1 2 3; do
    grep -qw "$c" /tmp/grid_card_reserve 2>/dev/null && continue
    cards="$cards $c"
  done
  echo "$cards"
}

launch_cell() {  # launch_cell <gpu> <ds> <method> <data> <exp>
  local g=$1 ds=$2 m=$3 data=$4 exp=$5
  local cell="${ds}_nemotron_${m}"
  local claim="$CLAIMDIR/${cell}.run"
  if pgrep -af "outputs/${cell}[ /]" >/dev/null 2>&1; then
    echo "$LOG_PREFIX $(date '+%F %T') SKIP $cell -- live external process on it"
    return 1
  fi
  mkdir "$claim" 2>/dev/null || return 1
  echo "$g $(date +%s)" > "$claim/info"
  echo "$LOG_PREFIX $(date '+%F %T') LAUNCH $cell gpu=$g exp=$exp data=$data"
  mkdir -p "outputs/${cell}"
  (
    setsid bash run_nemotron_grid_cell.sh "$g" "$ds" "$m" "$data" "$exp" \
      </dev/null >>"outputs/${cell}/run.log" 2>&1
    rc=$?
    echo "$LOG_PREFIX $(date '+%F %T') DONE  $cell gpu=$g rc=$rc" >> outputs/nemotron_grid_supply.log
    raw="outputs/${cell}/${cell}_full.jsonl"
    sn=0
    scored="outputs/${cell}/${cell}_full_single_scored.jsonl"
    [ -f "$scored" ] && sn=$(wc -l < "$scored")
    echo "$(date '+%F %T') cell=${cell} gpu=$g rc=$rc scored_rows=$sn" >> outputs/grid_done_events.log
    if [ $rc -ne 0 ]; then
      rn=0; [ -f "$raw" ] && rn=$(wc -l < "$raw")
      if [ "$rn" -eq 0 ]; then
        fc=$(( $(cat "$FAILDIR/${cell}.n" 2>/dev/null || echo 0) + 1 ))
        echo $fc > "$FAILDIR/${cell}.n"
        echo "$LOG_PREFIX $(date '+%F %T') FAIL $cell zero-row failure $fc/3"
        [ "$fc" -ge 3 ] && touch "$FAILDIR/${cell}.skip" && \
          echo "$LOG_PREFIX $(date '+%F %T') SKIP-STAMPED $cell (3 zero-row failures; structural gap candidate)"
      fi
    fi
    rm -rf "$claim"
  ) &
  return 0
}

card_busy_by_daemon() {
  local g=$1 f
  for f in "$CLAIMDIR"/*.run/info; do
    [ -f "$f" ] || continue
    local cg; cg=$(awk '{print $1}' "$f")
    [ "$cg" = "$g" ] && return 0
  done
  return 1
}

echo "$LOG_PREFIX $(date '+%F %T') nemotron supply daemon start pid=$$ (pool A: cards 4/5 short cells, window ${WINDOW_SEC}s; pool B: cards 0-3 after qwen3_done)"
while true; do
  for cf in "$CLAIMDIR"/*.run; do
    [ -d "$cf" ] || continue
    ccell=$(basename "$cf" .run)
    if ! pgrep -af "outputs/${ccell}[ /]" >/dev/null 2>&1; then
      echo "$LOG_PREFIX $(date '+%F %T') GC orphan claim $ccell (no live process)"
      rm -rf "$cf"
    fi
  done

  mapfile -t QUEUE < <(compute_queue)

  # ---- POOL A: cards 4/5, short cells only, inside the borrow window ----
  in_window=$(( ( $(date +%s) - WINDOW_START ) < WINDOW_SEC ))
  if [ "$in_window" = "1" ]; then
    for g in 4 5; do
      card_busy_by_daemon "$g" && continue
      card_free "$g" || continue
      card_ours "$g" || { echo "$LOG_PREFIX $(date '+%F %T') YIELD card $g (foreign process; no new pool-A cells)"; continue; }
      launched=0
      for spec in "${QUEUE[@]}"; do
        [ -z "$spec" ] && continue
        read -r ds m rest <<< "$spec"
        data=$(echo "$rest" | awk '{print $1}'); exp=$(echo "$rest" | awk '{print $2}')
        cell="${ds}_nemotron_${m}"
        echo " $SHORT_CELLS " | grep -q " $cell " || continue   # short cells only
        [ -d "$CLAIMDIR/${cell}.run" ] && continue
        if launch_cell "$g" "$ds" "$m" "$data" "$exp"; then launched=1; break; fi
      done
      [ "$launched" = "1" ] && sleep 20
    done
  else
    echo "$LOG_PREFIX $(date '+%F %T') pool-A window closed -- cards 4/5 get no new cells (running ones finish)"
  fi

  # ---- POOL B: cards 0-3, gated on the Qwen3 queue ----
  if ! qwen3_done; then
    echo "$LOG_PREFIX $(date '+%F %T') GATE: Qwen3 queue not empty yet -- pool B idle (cards 0-3 untouched)"
    sleep "$POLL"
    continue
  fi
  for g in $(available_cards); do
    card_busy_by_daemon "$g" && continue
    card_free "$g" || continue
    launched=0
    for spec in "${QUEUE[@]}"; do
      [ -z "$spec" ] && continue
      read -r ds m rest <<< "$spec"
      data=$(echo "$rest" | awk '{print $1}')
      exp=$(echo "$rest" | awk '{print $2}')
      cell="${ds}_nemotron_${m}"
      [ -d "$CLAIMDIR/${cell}.run" ] && continue
      if launch_cell "$g" "$ds" "$m" "$data" "$exp"; then launched=1; break; fi
    done
    [ "$launched" = "1" ] && sleep 20   # stagger model loads
  done
  nq=${#QUEUE[@]}
  nskip=$(ls "$FAILDIR"/*.skip 2>/dev/null | wc -l)
  echo "$LOG_PREFIX $(date '+%F %T') round: avail_cards=[$(available_cards)] incomplete=$nq skip_stamped=$nskip"
  [ "$nq" -eq 0 ] && echo "$LOG_PREFIX $(date '+%F %T') queue empty; idle-polling"
  sleep "$POLL"
done
