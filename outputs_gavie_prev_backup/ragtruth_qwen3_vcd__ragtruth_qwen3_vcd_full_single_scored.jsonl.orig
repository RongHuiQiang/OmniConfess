ion.", "question": "how to clean tarnished jewelry at home", "group_key": "ragtruth", "sub_category": "ragtruth", "dataset": "ragtruth", "method": "vcd", "has_vcd": false, "time_sec": 41.993, "status": "success", "eval_metrics": {"Token-F1": 8.25, "GAVIE-Rel": -1.0, "GAVIE-Acc": -1.0, "Status": "success"}}
