ilt, ensuring the fold is on the bias.\"]", "time_sec": 25.487, "generation_time_seconds": 24.5719, "selection_time_seconds": 0.9049, "record_process": true, "trajectories": [{"rollout": 0, "sampled": false, "token_ids": [28715, 389, 279, 2661, 46769, 11, 311, 11555, 264, 60736, 11, 1795, 1493, 7354, 1447, 16, 13, 43924, 697, 60736, 389, 264, 10063, 7329, 1741, 438, 264, 4845, 11, 1965, 11, 476, 1008, 10063, 7329, 624, 17, 13, 60473, 279, 4722, 1290, 9131, 705, 8841, 279, 4126, 315, 279, 60736, 11, 22573, 279, 11555, 374, 389, 279, 15470, 624, 18, 13, 60473, 279, 4722, 2115, 9131, 705, 8841, 279, 4126, 315, 279, 60736, 11, 22573, 279, 11555, 374, 389, 279, 15470, 624, 19, 13, 60473, 279, 1909, 2115, 9131, 1495, 8841, 279, 4126, 315, 279, 60736, 11, 22573, 279, 11555, 374, 389, 279, 15470, 624, 20, 13, 60473, 279, 1909, 1290, 9131, 1495, 8841, 279, 4126, 315, 279, 60736, 11, 22573, 279, 11555, 374, 389, 279, 15470, 13, 151645], "pred": "1. Lay your quilt on a flat surface such as a bed, table, or other flat surface.\n2. Fold the lower right corner up toward the center of the quilt, ensuring the fold is on the bias.\n3. Fold the lower left corner up toward the center of the quilt, ensuring the fold is on the bias.\n4. Fold the top left corner down toward the center of the quilt, ensuring the fold is on the bias.\n5. Fold the top right corner down toward the center of the quilt, ensuring the fold is on the bias.", "grounding_scores": {"g_mean_claim": 0.8987818629464891, "g_worst_claim": -0.009840538868537316, "g_content": 0.8017066319783529, "g_traj_mean": 0.747940182685852}}, {"rollout": 1, "sampled": true, "token_ids": [28715, 389, 279, 2661, 46769, 11, 311, 11555, 264, 60736, 11, 1795, 1493, 7354, 510, 16, 13, 43924, 697, 60736, 389, 264, 10063, 7329, 624, 17, 13, 60473, 279, 4722, 1290, 9131, 705, 8841, 279, 4126, 315, 279, 60736, 22573, 279, 11555, 374, 389, 279, 15470, 624, 18, 13, 60473, 279, 4722, 2115, 9131, 705, 8841, 279, 4126, 315, 279, 60736, 3259, 2704, 2