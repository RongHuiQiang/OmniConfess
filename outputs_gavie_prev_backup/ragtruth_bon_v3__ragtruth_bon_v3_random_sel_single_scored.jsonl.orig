700, 323, 9318, 11405, 3377, 220, 18, 20, 22, 20, 13, 1096, 1352, 646, 387, 12771, 705, 518, 894, 547, 808, 13, 3877, 8246, 11, 75210, 311, 894, 3877, 8246, 11, 476, 3897, 311, 894, 54217, 14874, 50861, 13, 576, 1352, 646, 387, 14634, 518, 894, 547, 808, 13, 3877, 8246, 11, 75210, 311, 894, 3877, 8246, 11, 476, 3897, 311, 894, 54217, 14874, 50861, 13, 151645], "pred": "3. **Form Submission:** You can fill out and submit PS Form 3575. This form can be picked up at any U.S. Post Office, mailed to any Post Office, or provided to any Postal Mail Carrier. The form can be submitted at any U.S. Post Office, mailed to any Post Office, or provided to any Postal Mail Carrier.", "grounding_scores": {"g_mean_claim": 1.1759264590270997, "g_worst_claim": 0.06896032392978668, "g_content": 1.646507425511137, "g_traj_mean": 1.1555118560791016}}, {"rollout": 3, "sampled": true, "token_ids": [28715, 389, 279, 2661, 46769, 11, 279, 547, 808, 13, 54217, 5362, 6081, 264, 4937, 323, 31945, 2297, 315, 2621, 2473, 13, 1446, 646, 2297, 697, 2621, 2860, 1667, 279, 22651, 10388, 315, 9177, 1352, 13, 38478, 11, 498, 646, 1618, 279, 84876, 7143, 5832, 518, 220, 16, 12, 23, 15, 15, 12, 7384, 32340, 5012, 320, 16, 12, 23, 15, 15, 12, 17, 22, 20, 12, 23, 22, 22, 22, 8, 476, 5155, 700, 323, 9318, 11405, 3377, 220, 18, 20, 22, 20, 518, 894, 547, 808, 13, 3877, 8246, 13, 576, 1882, 25351, 429, 697, 821, 374, 9767, 448, 279, 5535, 25463, 14310, 13, 151645], "pred": "Based on the given passages, the U.S. Postal Service offers a fast and versatile change of address service. You can change your address online using the Official Change of Address form. Alternatively, you can call the USPS Call Center at 1-800-ASK-USPS (1-800-275-8777) or fill out and submit PS Form 3575 at any U.S. Post Office. The process ensures that your data is secure with the latest encryption technologies.", "grounding_scores": {"g_mean_claim": 1.1437464239550572, "g_worst_claim": 0.3681374390920003, "g_content": 2.11785434154754, "g