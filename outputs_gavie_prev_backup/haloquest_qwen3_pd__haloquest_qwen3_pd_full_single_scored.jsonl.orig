entified as a specific real-world flower.", "time_sec": 209.437, "generation_time_seconds": 208.9025, "selection_time_seconds": 0.03, "eval_metrics": {"Token-F1": 11.76, "GAVIE-Rel": -1.0, "GAVIE-Acc": -1.0, "Status": "success"}}
