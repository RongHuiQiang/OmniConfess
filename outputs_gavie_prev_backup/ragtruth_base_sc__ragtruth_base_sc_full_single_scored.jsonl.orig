ur hair."}, {"rollout": 1, "token_ids": [1249, 10277, 4240, 697, 6869, 11, 1795, 1493, 7354, 1447, 16, 13, 3070, 3379, 279, 64558, 1417, 47595, 323, 15180, 261, 66963, 22201, 264, 61932, 323, 64324, 429, 525, 14452, 369, 697, 6869, 943, 311, 5978, 7373, 58952, 382, 17, 13, 3070, 95275, 9959, 66963, 7405, 2704, 279, 3015, 374, 8205, 714, 537, 2238, 4017, 13, 27196, 279, 3015, 6396, 311, 5648, 12503, 19049, 382, 18, 13, 3070, 1001, 14438, 398, 44856, 279, 25697, 66963, 44856, 697, 6869, 26364, 1573, 18950, 279, 61932, 382, 19, 13, 3070, 28497, 1417, 47595, 66963, 11778, 264, 2613, 3311, 315, 61932, 320, 9096, 264, 51249, 27835, 3311, 8, 323, 975, 432, 1526, 697, 6869, 13, 1416, 498, 614, 5021, 6869, 11, 3614, 1526, 432, 448, 697, 19225, 311, 7949, 259, 17248, 382, 20, 13, 3070, 49, 258, 325, 66963, 57368, 325, 279, 61932, 700, 315, 697, 6869, 6587, 382, 21, 13, 3070, 28497, 15180, 261, 66963, 20552, 64324, 304, 279, 1852, 11566, 438, 279, 61932, 13, 26530, 432, 311, 7146, 389, 369, 264, 2421, 4420, 382, 22, 13, 3070, 49, 258, 325, 13759, 66963, 57368, 325, 279, 64324, 700, 26364, 382, 23, 13, 3070, 85215, 448, 264, 40393, 301, 66963, 42187, 264, 42613, 2163, 697, 6869, 311, 60692, 705, 13623, 3015, 13, 34006, 55935, 279, 6869, 1182, 323, 13241, 476, 304, 25362, 448, 279, 42613, 13, 12090, 11, 990, 264, 3272, 1280, 476, 30411, 10566, 11379, 311, 9058, 697, 6869, 29273, 382, 24, 13, 3070, 10253, 264, 25697, 30841, 261, 66963, 1416, 5871, 11, 990, 264, 6869, 46622, 311, 6587, 9058, 697, 6869, 382, 1359, 2701, 1493, 7354, 11, 498, 646, 5978, 429, 697, 6869, 374, 26364, 27722, 323, 41677, 369, 11, 20337, 1181, 2820, 323, 11094, 13, 151645], "logp_list": [-0.1682, -0.0006, -0.0, -0.0001, 0.0, -0.0079, -0.0188, -0.0031, -0.0011, -0.069, -0.0017, -0.0351, -1.3119, -0.1601, -0.0092, -0.3612, -0.0579, -0.0, -0.0029, -0.0, 0.0, -1.3596, -0.0425, -0.155, -0.0003, -0.0, -0.0, -0.4555, -0.044, -0.0355, 0.0, -0.0, -0.0029, -0.0, -4.5613, -0.0086, -0.1392, -0.6934, -3.2341, -0.0, 0.0