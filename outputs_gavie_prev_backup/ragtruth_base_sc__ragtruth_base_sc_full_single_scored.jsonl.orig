0186, -0.0007, -2.7759, -0.011, -0.4809, -0.0, -0.0028, -0.0016, -0.0002, -0.0066, -0.0, 0.0, -0.0, -0.0068, -0.1025, -0.0313], "cumulative_logprob": -42.8079, "norm_logp": -0.2489, "input_len": 587, "output_tokens": 172, "pred": "To fix a door that won't lock, you should first close the door and try to lock it. If it won't lock, open the door, tap the end of a chisel under the door stop on the striker side of the jamb, and pry up on it until it comes loose. Remove the door stop using the chisel. Next, set the door stop back on the jamb, aligning it with a distinct line in the paint, stain, or varnish where it came off, and nail it back in place. If the door latch won't catch, you may have to enlarge the latch hole in the jamb and tighten the hinges first. Enlarge the strike plate hole and move the strike plate to ensure proper alignment. If the latch still doesn't catch, make sure all the door's hinge screws are tight."}, {"rollout": 1, "token_ids": [8304, 220, 16, 25, 64547, 279, 3491, 481, 576, 6006, 374, 537, 37855, 10277, 624, 8304, 220, 17, 25, 9192, 369, 4650, 11137, 481, 576, 21085, 33845, 429, 279, 6006, 56926, 1231, 537, 5285, 448, 279, 14178, 304, 279, 13169, 11968, 624, 8304, 220, 18, 25, 4248, 369, 9904, 481, 576, 21085, 5707, 264, 6291, 369, 419, 4265, 553, 22561, 311, 3271, 279, 13169, 11968, 624, 8304, 220, 19, 25, 25429, 421, 279, 6291, 374, 2697, 481, 576, 21085, 5707, 2797, 11221, 389, 1246, 311, 3271, 279, 13169, 11968, 11, 22573, 432, 5285, 82, 10277, 448, 279, 56926, 14178, 624, 8304, 220, 20, 25, 1200, 857, 481, 20205, 389, 279, 1995, 3897, 304, 279, 21085, 11, 279, 6291, 311, 5046, 264, 6006, 429, 2765, 944, 5296, 374, 311, 3271, 279, 13169, 11968, 311, 5978, 432, 5285, 82, 10277, 448, 279, 56926, 14178, 382, 16141, 25, 14561, 279, 13169, 11968, 311, 5978, 432, 5285, 82, 10277, 448, 279, 56926, 14178, 13, 151645], "logp_list": [-2.949, -0.0004, -0.0, -0.0, -0.0526, -0.0043, -0.242, -0.4697, -0.0157, -0.5568, -3.1775, -0.0069, -0.0018, -0.064,