, -0.648, -1.7521, -1.1445, -0.2211, -0.2348, -0.0114, -0.0087, -0.004, -0.0007, -0.0029, -0.0, -1.1274, -1.8588, -0.1084, -0.0804, -0.0591, -0.429, -0.2462, -0.1968, -0.0071, -0.0007], "cumulative_logprob": -10.8631, "norm_logp": -0.4178, "input_len": 172, "output_tokens": 26}, {"phase": "rollout", "beam": 0, "token_ids": [28959, 323, 62079, 279, 13495, 323, 11137, 315, 358, 7347, 3897, 304, 279, 46769, 13, 151645], "logp_list": [-1.6897, -2.104, -0.5551, -0.01, -0.7924, -0.017, -0.0022, -0.008, -0.0, -0.0, -5.5429, -0.0038, -0.0002, -0.0431, -0.2226, -0.0038], "cumulative_logprob": -10.9948, "norm_logp": -0.6872, "input_len": 172, "output_tokens": 16}, {"phase": "rollout", "beam": 0, "token_ids": [4418, 1526, 2176, 46769, 311, 1477, 894, 11464, 6286, 315, 279, 13495, 323, 11137, 315, 358, 7347, 13, 151645], "logp_list": [-1.6004, -0.1362, -6.7974, -0.0224, -0.7434, -0.9447, -1.2842, -0.9237, -0.8758, -0.0163, -2.9056, -0.0061, -0.1156, -0.0004, -0.002, -0.0017, -0.0, -0.0775, -0.3777], "cumulative_logprob": -16.8311, "norm_logp": -0.8858, "input_len": 172, "output_tokens": 19}, {"phase": "vote", "beam": null, "token_ids": [785, 1850, 5754, 374, 314, 18, 92, 151645], "logp_list": [-0.8089, -0.0367, -0.0, -0.0, -0.8004, -1.3414, -0.5514, -0.0206], "cumulative_logprob": -3.5594, "norm_logp": -0.4449, "input_len": 407, "output_tokens": 8}, {"phase": "vote", "beam": null, "token_ids": [785, 1850, 5754, 374, 220, 19, 13, 151645], "logp_list": [-0.8089, -0.0367, -0.0, -0.0, -0.6218, -2.535, -0.1439, -0.0105], "cumulative_logprob": -4.1568, "norm_logp": -0.5196, "input_len": 407, "output_tokens": 8}, {"phase": "final", "beam": 0, "token_ids": [16141, 25, 41444, 311, 4226, 3118, 389, 2661, 46769, 13, 151645], "logp_list": [-1.039, -0.0926, -0.6916, -0.0, -0.0003, -0.0004, -0.0, -0.0028, -0.0001, -0.024, -0.0012], "cumulative_logprob": -1.852, "norm_logp": -0.1684, "input_len": 170, "output_tokens": 11}], "output_tokens": 666, "eval_metrics": {"Token-F1": 6.06, "GAVIE-Rel":