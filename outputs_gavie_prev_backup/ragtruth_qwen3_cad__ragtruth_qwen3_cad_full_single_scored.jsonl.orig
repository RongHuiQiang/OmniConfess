 "passage", "time_sec": 36.382, "status": "success", "record_process": true, "token_ids": [7771, 55179, 2692, 374, 27092, 16061, 1576, 498, 1483, 264, 4843, 24031, 3766, 311, 2615, 432, 13, 55179, 48040, 3847, 5248, 3039, 1573, 37855, 9618, 369, 419, 2874, 11, 323, 421, 498, 3949, 18993, 320, 27856, 476, 803, 3039, 8, 323, 5497, 697, 3552, 2041, 1217, 2056, 2615, 11, 432, 14807, 697, 2692, 572, 16061, 4152, 311, 4843, 24031, 906, 10431, 13, 55179, 4990, 419, 1917, 311, 6016, 1196, 4763, 11, 438, 4843, 24031, 10500, 646, 2182, 697, 323, 697, 4780, 6, 821, 518, 5214, 13, 4329, 3847, 614, 1083, 3949, 3946, 14298, 504, 55179, 9958, 1105, 911, 4843, 24031, 10500, 1573, 1660, 16061, 700, 13, 151645], "logp_list": [-0.0575, -0.0, -0.0045, -0.591, -0.1646, -0.0001, -0.0898, -0.0722, -0.1294, -0.4741, 0.0, 0.0, -0.0789, -0.0, -0.0001, -0.0701, -0.0032, -0.0002, -0.0043, -0.0001, -0.2815, 0.0, -0.3267, -0.0091, -0.4993, -0.3903, -0.2655, -0.016, -0.2848, -0.0094, -0.8461, -0.2597, -0.9431, -0.4352, -0.1867, -0.9871, -0.0068, -0.3869, -0.0831, -0.4903, -0.1611, -1.1207, -0.0003, -0.0, -0.4951, -0.7643, -0.0, -0.0, -0.0135, -0.5904, -1.2278, -0.9705, -0.0001, -0.9605, -0.0635, -0.4101, -0.0, -0.1677, -0.0, -0.0024, -0.0089, -0.0002, -0.626, -0.9748, -0.1838, -1.1232, -0.0934, -0.1621, -0.0728, -0.0016, -0.1341, -0.3991, -1.0743, -0.0001, -0.0018, -1.1106, -0.5747, -1.3592, -0.5063, -0.0055, -0.0068, -0.2812, -0.4866, -0.0, -0.0001, -0.0456, -0.5126, -0.0015, -0.1166, -0.5057, -0.1353, -0.494, -0.7341, -0.0911, -0.0, -0.3935, -0.2522, -0.2432, -0.1458, -0.0006, -0.3034, -0.1456, -0.0403, -0.0004, -0.0046, -0.0012, -0.036], "cumulative_logprob": -28.7862, "norm_logp": -0.269, "input_len": 559, "output_tokens": 107, "eval_metrics": {"Token-F1": 34.78, "GAVIE-Rel": 9.5, "GAVIE-Acc": 8.5, "Status": "success", "GAVIE-Judge": "glm-4.5-flash"}}
