{"id": "310", "question": "avg cost to install a second floor in a house", "gt": "Hiring a remodeling contractor to build a second floor addition can cost between $100-$300 a square foot for a typical addition, but the cost can go as high as $400-$500 per square foot depending on the complexity, quality of materials and local labor rates. Building a second floor can cost at least 20 percent more than building the same square footage at ground level.", "pred": "Unable to answer based on given passages.", "group_key": "ragtruth", "sub_category": "ragtruth", "dataset": "ragtruth", "method": "bon_grounding_random_sel", "raw_output": "Unable to answer based on given passages.", "cot": "[\"Unable to answer based on given passages.\", \"$300-$400 per square foot\", \"Unable to answer based on given passages.\", \"Unable to answer based on given passages.\"]", "time_sec": 7.127, "generation_time_seconds": 6.4959, "selection_time_seconds": 0.6248, "record_process": true, "trajectories": [{"rollout": 0, "sampled": false, "token_ids": [17075, 311, 4226, 3118, 389, 2661, 46769, 13, 151645], "pred": "Unable to answer based on given passages.", "grounding_scores": {"g_mean_claim": -0.09390845894813538, "g_worst_claim": -0.09390845894813538, "g_content": -0.1480647563934326, "g_traj_mean": -0.08350269496440887}}, {"rollout": 1, "sampled": true, "token_ids": [3, 18, 15, 15, 21389, 19, 15, 15, 817, 9334, 4478, 151645], "pred": "$300-$400 per square foot", "grounding_scores": {"g_mean_claim": 1.5855385173450818, "g_worst_claim": 1.5855385173450818, "g_content": 0.2930022716522217, "g_traj_mean": 1.4598804712295532}}, {"rollout": 2, "sampled": true, "token_ids": [17075, 311, 4226, 3118, 389, 2661, 46769, 13, 151645], "pred": "Unable to answer based on given passages.", "grounding_scores": {"g_mean_claim": -0.09390845894813538, "g_worst_claim": -0.09390845894813538, "g_content": -0.1480647563934326, "g_traj_mean": -0.08350269496440887}}, {"rollout": 3, "sampled": true, "token_ids": [17