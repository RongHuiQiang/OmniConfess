22544, 279, 1471, 1023, 1461, 9942, 3080, 807, 614, 29105, 323, 81623, 6707, 11, 892, 4990, 911, 220, 16, 20, 4420, 11, 1992, 1378, 34254, 315, 17163, 389, 1909, 315, 1817, 1461, 1149, 11, 470, 279, 1471, 1023, 1461, 9942, 448, 17163, 311, 279, 23387, 323, 2138, 279, 17163, 311, 28999, 11, 892, 4990, 911, 220, 18, 4420, 24719, 151645], "pred": "[Preheat the oven to 350 degrees Fahrenheit, season the pollock fillets with paprika and black pepper, bake the pollock fillets until they have cooked and flakes easily, which takes about 15 minutes, place two slices of cheese on top of each fillet, return the pollock fillets with cheese to the oven and allow the cheese to melt, which takes about 3 minutes.]", "grounding_scores": {"g_mean_claim": 0.40191471284089053, "g_worst_claim": -0.6440505504608154, "g_content": 0.7258067029587766, "g_traj_mean": 0.4960262179374695}}, {"rollout": 3, "sampled": true, "token_ids": [1249, 4296, 1471, 1023, 11, 855, 19963, 279, 23387, 311, 220, 18, 20, 15, 12348, 434, 320, 16, 22, 20, 12348, 356, 568, 14263, 279, 1471, 1023, 1461, 9942, 448, 25298, 40454, 323, 3691, 24353, 13, 52074, 279, 1461, 9942, 304, 279, 855, 383, 657, 23387, 3080, 807, 614, 29105, 323, 1320, 726, 6707, 11, 892, 4990, 911, 220, 16, 20, 4420, 13, 4636, 17592, 279, 7640, 504, 279, 23387, 11, 1992, 1378, 34254, 315, 17163, 389, 1817, 1461, 1149, 13, 3411, 279, 1461, 9942, 311, 279, 23387, 323, 2138, 279, 17163, 311, 28999, 11, 892, 4990, 911, 220, 18, 4420, 13, 151645], "pred": "To cook pollock, preheat the oven to 350 degrees F (175 degrees C). Season the pollock fillets with paprika and black pepper. Bake the fillets in the preheated oven until they have cooked and flake easily, which takes about 15 minutes. After removing the fish from the oven, place two slices of cheese on each fillet. Return the fillets to the oven and allow the cheese to melt, which takes about 3 minutes.", "grounding_scores": {"g_mean_claim": 1.0758508696914548, "g_worst_claim": 0.4749657426561628