7, 17654, 311, 1281, 49247, 96577, 382, 18, 13, 47716, 279, 96577, 389, 264, 27815, 10834, 382, 19, 13, 52074, 279, 96577, 304, 279, 855, 383, 657, 23387, 3080, 807, 525, 9058, 714, 537, 92872, 11, 892, 4990, 911, 220, 21, 311, 220, 23, 4420, 13, 72323, 279, 27815, 10834, 10917, 2337, 27815, 311, 5978, 1496, 45379, 382, 20, 13, 10783, 279, 96577, 504, 279, 23387, 323, 1077, 1105, 7010, 6587, 382, 9485, 7354, 686, 1102, 304, 281, 92852, 96577, 429, 525, 14452, 369, 5257, 17233, 8357, 13, 151645], "pred": "These steps will result in panko crumbs that are suitable for various cooking applications.", "grounding_scores": {"g_mean_claim": 1.0032156675832793, "g_worst_claim": 0.0824680978601629, "g_content": 1.2538557052612305, "g_traj_mean": 0.9190263152122498}}, {"rollout": 3, "sampled": true, "token_ids": [16, 13, 4968, 19963, 279, 23387, 311, 220, 18, 15, 15, 12348, 434, 320, 16, 20, 15, 12348, 356, 4292, 17, 13, 22950, 26757, 315, 4158, 16002, 1526, 279, 52362, 287, 13364, 315, 264, 3607, 17654, 311, 1281, 49247, 96577, 624, 18, 13, 47716, 279, 96577, 389, 264, 27815, 10834, 323, 22544, 518, 220, 18, 15, 15, 434, 12348, 3080, 279, 96577, 525, 9058, 714, 537, 92872, 11, 911, 220, 21, 311, 220, 23, 4420, 624, 19, 13, 72323, 279, 10834, 10917, 2337, 27815, 624, 20, 13, 10783, 504, 279, 23387, 323, 7010, 6587, 13, 151645], "pred": "1. Preheat the oven to 300 degrees F (150 degrees C).\n2. Push chunks of white bread through the shredding disk of a food processor to make coarse crumbs.\n3. Spread the crumbs on a baking sheet and bake at 300 F degrees until the crumbs are dry but not toasted, about 6 to 8 minutes.\n4. Shake the sheet twice during baking.\n5. Remove from the oven and cool completely.", "grounding_scores": {"g_mean_claim": 1.606926917342653, "g_worst_claim": 0.5168430103975183, "g_content": 2.235264653744905, "g_traj_mean": 1.4560507535934448}}], "selected_rollout": 3, "random_sel_rollout": 2, "rank_score": "g_content", "partner": "psg-borrow", "error": null, 