], "pred": "These steps help you set either Microsoft Edge or Mozilla Firefox as the default browser in Windows 7.", "grounding_scores": {"g_mean_claim": 0.8932443569856461, "g_worst_claim": 0.1902260184288025, "g_content": 1.1793688193134877, "g_traj_mean": 0.905109167098999}}, {"rollout": 2, "sampled": true, "token_ids": [1649, 1638, 6929, 311, 11030, 271, 16, 13, 5264, 11296, 906, 624, 17, 13, 9189, 279, 1156, 2999, 24849, 739, 320, 5493, 11, 21969, 11, 10500, 11, 2355, 4292, 18, 13, 9189, 7899, 10500, 624, 19, 13, 22392, 1495, 279, 2150, 311, 1490, 4895, 6929, 3772, 624, 20, 13, 9189, 389, 279, 10349, 6929, 4343, 320, 269, 894, 6929, 1008, 1091, 17225, 8, 311, 16400, 22201, 458, 906, 11, 323, 1221, 4205, 5085, 17225, 311, 738, 432, 438, 1638, 6929, 382, 92014, 11, 738, 34733, 25929, 438, 697, 1638, 5515, 6929, 1447, 16, 13, 5264, 697, 25929, 6929, 624, 17, 13, 9189, 389, 279, 25929, 5022, 3137, 11, 15251, 553, 2326, 16202, 5128, 323, 7407, 304, 279, 8416, 1290, 1424, 9131, 315, 279, 6929, 3241, 624, 18, 13, 8427, 14566, 13, 151645], "pred": "1. Open your Firefox browser.\n2. Click on the Firefox menu button, represented by three horizontal lines and located in the upper right hand corner of the browser window.\n3. Select Options.", "grounding_scores": {"g_mean_claim": 1.9758797995383335, "g_worst_claim": -0.25584256649017334, "g_content": 2.2655419921875, "g_traj_mean": 1.9110565185546875}}, {"rollout": 3, "sampled": true, "token_ids": [1249, 738, 279, 1638, 6929, 311, 5515, 1447, 16, 13, 5264, 11296, 906, 13, 2014, 653, 773, 11, 1787, 5145, 5022, 323, 1221, 4205, 11296, 4603, 13, 38478, 11, 498, 646, 990, 5515, 488, 358, 13625, 37115, 311, 6157, 1787, 11296, 906, 382, 17, 13, 9189, 279, 1156, 2999, 24849, 739, 320, 5493, 11, 21969, 11, 10500, 11, 2355, 3593, 18, 13, 758, 279, 2115, 38452, 11, 4205, 7899, 10500, 382, 19, 13, 4695, 11, 389, 279, 1290, 24067, 11, 9059, 1495, 279, 2150, 311, 1490, 4895, 6929, 3772, 382, 20, 13, 9189, 389, 279, 6929, 498, 1366, 311,