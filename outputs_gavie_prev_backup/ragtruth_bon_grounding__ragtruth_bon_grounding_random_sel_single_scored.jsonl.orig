4, 483, 35067, 90078, 369, 11051, 8628, 11, 1667, 458, 15789, 39058, 13, 8658, 398, 5590, 279, 85354, 13, 758, 264, 19212, 11, 6514, 3786, 51514, 12021, 11, 3691, 24353, 11, 30635, 16723, 11, 37327, 16723, 11, 25298, 40454, 11, 73188, 12570, 34448, 19187, 11, 323, 16205, 17172, 287, 3080, 26364, 10856, 13, 57368, 325, 279, 35067, 90078, 323, 84847, 279, 14401, 90078, 389, 2176, 11067, 448, 279, 41686, 20980, 13, 3085, 697, 6078, 11, 6245, 279, 41686, 10273, 1119, 279, 13041, 323, 2138, 311, 2498, 369, 220, 16, 15, 4420, 13, 49848, 279, 90078, 916, 24614, 8628, 3080, 902, 5021, 18217, 4766, 11, 911, 220, 16, 17, 4420, 817, 3108, 13, 151645], "pred": "Grill pork chops for medium heat, using an outdoor grill. Lightly oil the grate. In a bowl, mix together seasoned salt, black pepper, garlic powder, onion powder, paprika, Worcestershire sauce, and smoke flavoring until thoroughly combined. Rinse the pork chops and sprinkle the wet chops on both sides with the spice mixture. With your hands, massage the spice rub into the meat and allow to stand for 10 minutes. Grill the chops over indirect heat until no longer pink inside, about 12 minutes per side.", "grounding_scores": {"g_mean_claim": 1.519146923865428, "g_worst_claim": 0.4745750029881795, "g_content": 2.3546308320144127, "g_traj_mean": 1.7227184772491455}}, {"rollout": 3, "sampled": true, "token_ids": [1249, 39058, 35067, 90078, 11, 855, 19963, 458, 15789, 39058, 369, 11051, 8628, 323, 33404, 5590, 279, 85354, 13, 758, 264, 19212, 11, 6514, 51514, 12021, 11, 3691, 24353, 11, 30635, 16723, 11, 37327, 16723, 11, 25298, 40454, 11, 73188, 12570, 34448, 19187, 11, 323, 16205, 17172, 287, 3080, 26364, 10856, 13, 57368, 325, 35067, 90078, 323, 84847, 279, 14401, 90078, 389, 2176, 11067, 448, 279, 41686, 20980, 13, 3085, 697, 6078, 11, 6245, 279, 41686, 10273, 1119, 279, 13041, 26, 2138, 311, 2498, 369, 220, 16, 15, 4420, 13, 49848, 279, 90078, 916, 24614, 8628, 3080, 902, 5021, 18217, 4766, 11, 911, 220, 16, 17, 4420, 817, 3108, 13, 151645], "pred": "To grill pork chops, preheat an outdoor grill for medium heat and lightly oil the grate. In a bowl, mix seasoned salt, black pepper, garlic powder, onion powder, paprika, Worcestershire sauce, and smoke flavoring until thoroughly combined. Rinse pork chops and sprinkle the wet chops on both sides with the spice mixture. With your hands, massage the spice rub into the meat; allow to stand for 10 minutes. Grill the chops over indirect heat until no longer pink inside, about 12 minutes per side.", "grounding_scores": {"g_mean_claim": 1.4163260698335605, "g_worst_claim": 0.40811769167582196, "g_content": 1.9409056546395285, "g_traj_mean": 1.6160751581192017}}], "selected_rollout": 2, "random_sel_rollout": 1, "rank_score": "g_content", "partner": "psg-borrow", "error": null, "eval_metrics": {"Token-F1": 92.31, "GAVIE-Rel": 10.0, "GAVIE-Acc": 10.0, "Status": "success"}}
{"id": "250", "question": "how to grill pork chops, allrecipes.com", "gt": "To grill pork chops according to allrecipes.com, preheat an outdoor grill for medium heat and lightly oil the grate. In a bowl, mix together seasoned salt, black pepper, garlic powder, onion powder, paprika, Worcestershire sauce, and smoke flavoring. Rinse the pork chops and sprinkle the wet chops on both sides with the spice mixture. Massage the spice rub into the meat and let it stand for 10 minutes. Grill the chops over indirect heat for about 12 minutes per side or until they are no longer pink inside.", "pred": "Grill pork chops by preheating an outdoor grill for medium heat, lightly oiling the grate, and seasoning the pork chops with a spice mixture. Rub the spice mixture into the meat by hand and let it stand for 10 minutes. Grill the chops over indirect heat until no longer pink inside, about 12 minutes per side.", "group_key": "ragtruth", "sub_category": "ragtruth", "dataset": "ragtruth", "method": "bon_grounding_random_sel", "raw_output": "Grill pork chops by preheating an outdoor grill for medium heat, lightly oiling the grate, and seasoning the pork chops with a spice mixture. Rub the spice mixture into the meat by hand and let it stand for 10 minutes. Grill the chops over indirect heat until no longer pink inside, about 12 minutes per side.", "cot": "[\"To grill pork chops, preheat an outdoor grill for medium heat, and lightly oil the grate. In a bowl, mix together the seasoned salt, black pepper, garlic powder, onion powder, paprika, Worcestershire sauce, and smoke flavoring until thoroughly combined. Rinse pork chops, and sprinkle the wet chops on both sides with the spice mixture. With your hands, massage the spice rub into the meat; allow to stand for 10 minutes. Grill the chops over indirect heat until no longer pink inside, about 12 minutes per side.\", \"Preheat an outdoor grill for medium heat, and lightly oil the grate. In a bowl, mix together the seasoned salt, black pepper, garlic powder, onion powder, paprika, Worcestershire sauce, and smoke flavoring until thoroughly combined. Rinse pork chops, and sprinkle the wet chops on both sides with the spice mixture. Grill the chops over indirect heat until no longer pink inside, about 12 minutes per side.\", \"Grill pork chops by preheating an outdoor grill for medium heat, lightly oiling the grate, and seasoning the pork chops with a spice mixture. Rub the spice mixture into the meat by hand and let it stand for 10 minutes. Grill the chops over indirect heat until no longer pink inside, about 12 minutes per side.\", \"To grill pork chops, follow these steps:\\n\\n1. Preheat an outdoor grill for medium heat and lightly oil the grate.\\n2. In a bowl, mix seasoned salt, black pepper, garlic powder, onion powder, paprika, Worcestershire sauce, and smoke flavoring until thoroughly combined.\\n3. Rinse pork chops and sprinkle the spice mixture on both sides.\\n4. With your hands, massage the spice rub into the meat and allow it to stand for 10 minutes.\\n5. Grill the pork chops over indirect heat until no longer pink inside, approximately 12 minutes per side.\"]", "time_sec": 17.331, "generation_time_seconds": 16.8127, "selection_time_seconds": 0.5115, "record_process": true, "trajectories": [{"rollout": 0, "sampled": false, "token_ids": [1249, 39058, 35067, 90078, 11, 855, 19963, 458, 15789, 39058, 369, 11051, 8628, 11, 323, 33404, 5590, 279, 85354, 13, 758, 264, 19212, 11, 6514, 3786, 279, 51514, 12021, 11, 3691, 24353, 11, 30635, 16723, 11, 37327, 16723, 11, 25298, 40454, 11, 73188, 12570, 34448, 19187, 11, 323, 16205, 17172, 287, 3080, 26364, 10856, 13, 57368, 325, 35067, 90078, 11, 323, 84847, 279, 14401, 90078, 389, 2176, 11067, 448, 279, 41686, 20980, 13, 3085, 697, 6078, 11, 6245, 279, 41686, 10273, 1119, 279, 13041, 26, 2138, 311, 2498, 369, 220, 16, 15, 4420, 13, 49848, 279, 90078, 916, 24614, 8628, 3080, 902, 5021, 18217, 4766, 11, 911, 220, 16, 17, 4420, 817, 3108, 13, 151645], "pred": "To grill pork chops, preheat an outdoor grill for medium heat, and lightly oil the grate. In a bowl, mix together the seasoned salt, black pepper, garlic powder, onion powder, paprika, Worcestershire sauce, and smoke flavoring until thoroughly combined. Rinse pork chops, and sprinkle the wet chops on both sides with the spice mixture. With your hands, massage the spice rub into the meat; allow to stand for 10 minutes. Grill the chops over indirect heat until no longer pink inside, about 12 minutes per side.", "grounding_scores": {"g_mean_claim": 1.4896129295764824, "g_worst_claim": 0.4693143367767334, "g_content": 2.0194362771922143, "g_traj_mean": 1.677390694618225}}, {"rollout": 1, "sampled": true, "token_ids": [4703, 19963, 458, 15789, 39058, 369, 11051, 8628, 11, 323, 33404, 5590, 279, 85354, 13, 758, 264, 19212, 11, 6514, 3786, 279, 51514, 12021, 11, 3691, 24353, 11, 30635, 16723, 11, 37327, 16723, 11, 25298, 40454, 11, 73188, 12570, 34448, 19187, 11, 323, 16205, 17172, 287, 3080, 26364, 10856, 13, 57368, 325, 35067, 90078, 11, 323, 84847, 279, 14401, 90078, 389, 2176, 11067, 448, 279, 41686, 20980, 13, 49848, 279, 90078, 916, 24614, 8628, 3080, 902, 5021, 18217, 4766, 11, 911, 220, 16, 17, 4420, 817, 3108, 13, 151645], "pred": "Preheat an outdoor grill for medium heat, and lightly oil the grate. In a bowl, mix together the seasoned salt, black pepper, garlic powder, onion powder, paprika, Worcestershire sauce, and smoke flavoring until thoroughly combined. Rinse pork chops, and sprinkle the wet chops on both sides with the spice mixture. Grill the chops over indirect heat until no longer pink inside, about 12 minutes per side.", "grounding_scores": {"g_mean_claim": 1.5339418366763669, "g_worst_claim": 0.528656005859375, "g_content": 2.3696970732315727, "g_traj_mean": 1.7359493970870972}}, {"rollout": 2, "sampled": true, "token_ids": [6464, 483, 35067, 90078, 553, 855, 383, 1095, 458, 15789, 39058, 369, 11051, 8628, 11, 33404, 5590, 287, 279, 85354, 1